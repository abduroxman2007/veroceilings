# Create React App build configuration.

# Disable inlining images as base64 data URIs.
#
# CRA inlines any image under 10,000 bytes into the main JS bundle. After the
# image optimisation pass, 10 images dropped under that threshold and were
# absorbed into main.js — 86.6 KB of base64, 12.5% of the bundle.
#
# That is bad here for two reasons:
#   1. main.js is render-blocking, so image bytes sit in the critical path.
#   2. A data URI cannot be lazy-loaded, so inlining silently cancels the
#      loading="lazy" attributes on those images.
#
# Emitting them as separate cacheable files is the right trade for an
# image-heavy marketing site.
IMAGE_INLINE_SIZE_LIMIT=0

# Source maps are ~2 MB of public build output that only helps attackers read
# your code. Flip back to true if you wire up error monitoring that needs them.
GENERATE_SOURCEMAP=false
