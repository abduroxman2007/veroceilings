# Copy to .env.local and fill in real values. Never commit .env.local.

# Required — Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Telegram lead-alert bot. Leave blank to silently skip alerts.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Optional — Yandex Webmaster site verification. Get the real token by
# verifying https://veroceilings.uz at https://webmaster.yandex.com first.
NEXT_PUBLIC_YANDEX_VERIFICATION=
